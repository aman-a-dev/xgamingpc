// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  
  telegramId String?   @unique
  username   String?
  
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart?   
  orders    Order[]
}

enum Role {
  USER
  ADMIN
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  price       Decimal       @db.Decimal(10, 2)
  stock       Int           @default(1)
  status      ProductStatus @default(ACTIVE)

  images      Image[]
  cartItems   CartItem[]
  orderItems OrderItem[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([name])
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  isCover   Boolean  @default(false)

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

// ─── CART TABLES ───────────────────────────────────────────────

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique 
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items     CartItem[]
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  quantity  Int      @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId]) 
  @@index([cartId])
  @@index([productId])
}


// ─── ORDER TABLES ──────────────────────────────────────────────

model Order {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       OrderItem[]
  total       Decimal       @db.Decimal(10, 2)

  status      OrderStatus   @default(PENDING_RECEIPT)

  receiptId   Int?          @unique
  receipt     Receipt?      @relation(fields: [receiptId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING_RECEIPT   // created, waiting for user to submit receipt
  VERIFYING         // receipt submitted, Check.et lookup in progress
  VERIFIED          // receipt confirmed valid, ready to fulfill
  REJECTED          // receipt failed verification (mismatch/fraud/reused)
  FULFILLED         // delivered
  CANCELLED
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2) // snapshot — product.price can change later

  @@index([orderId])
  @@index([productId])
}

// ─── RECEIPT VERIFICATION ──────────────────────────────────────

model Receipt {
  id              Int             @id @default(autoincrement())
  order           Order?

  reference       String          @unique
  bank            BankProvider    @default(TELEBIRR)
  payerName       String?
  amount          Decimal         @db.Decimal(10, 2)
  
  status          VerificationStatus @default(PENDING)
  rawResponse     Json?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
}

enum BankProvider {
  CBE
  TELEBIRR
}

enum VerificationStatus {
  PENDING
  VALID
  INVALID
  ALREADY_USED   // same reference reused on another order — important to check!
  FAILED         // Check.et API error, not a verdict on the receipt itself
}